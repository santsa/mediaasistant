RDS_HOST=<endpoint-rds>
RDS_PORT=5432
RDS_DB=medassistant_prod
RDS_USERNAME=postgres
RDS_PASSWORD=<password-rds>

GOOGLE_AI_API_KEY=<api-key-gemini>

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_ISSUER_URI=http://<elastic-ip>:8090/realms/medassistant